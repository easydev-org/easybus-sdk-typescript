{
  "name": "@easybus/sdk",
  "version": "0.1.0",
  "description": "easybus protocol SDK (TypeScript) — the multi-tenant extension bus. Wire contract: proto/easybus/v1/protocol.proto (the single source of truth, shared with easybus-sdk Go/Python/Rust).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "proto"
  ],
  "scripts": {
    "gen": "buf generate --template proto/buf.gen.yaml --path proto",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/obj": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
