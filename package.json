{
  "name": "@easydev-org/easybus-sdk",
  "version": "0.3.5",
  "description": "easybus protocol SDK (TypeScript) — the multi-tenant extension bus. Wire contract: proto/easybus/v1/protocol.proto (the single source of truth, shared with easybus-sdk Go/Python/Rust).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easydev-org/easybus-sdk-typescript.git"
  },
  "scripts": {
    "gen": "cd proto && buf generate --template buf.gen.yaml",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/obj": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
